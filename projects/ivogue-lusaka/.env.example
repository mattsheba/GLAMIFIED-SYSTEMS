# ── Supabase (orders, trade-in leads, live stock) ──────────────
# Project → Settings → API. The service role key bypasses RLS and must
# never be exposed to the browser — it lives only in Netlify env vars.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# ── Lenco payments (Airtel, MTN, Zamtel, cards) ────────────────
# Dashboard → Settings → API Keys, and Webhooks for the secret.
LENCO_API_URL=https://api.lenco.co/access/v2
LENCO_PUBLIC_KEY=pub-your_public_key
LENCO_SECRET_KEY=your_secret_key
LENCO_WEBHOOK_SECRET=your_webhook_signing_secret

# ── Email (receipts to customers, alerts to the counter) ───────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shop@ivoguelusaka.com
SMTP_PASS=your_app_password
FROM_EMAIL=shop@ivoguelusaka.com
ADMIN_EMAIL=shop@ivoguelusaka.com

# ── Site ───────────────────────────────────────────────────────
SITE_URL=https://ivoguelusaka.com
